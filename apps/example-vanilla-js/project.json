{
  "name": "example-vanilla-js",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/example-vanilla-js/src",
  "projectType": "application",
  "tags": ["type:app", "scope:examples"],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/example-vanilla-js"],
      "defaultConfiguration": "production",
      "options": {
        "config": "./vite.config.ts",
        "outDir": "../../dist/apps/example-vanilla-js"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        },
        "portal": {
          "mode": "portal"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "defaultConfiguration": "production",
      "configurations": {
        "production": {}
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../coverage/apps/example-vanilla-js"
      }
    }
  }
}
