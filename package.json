{
  "name": "@gurezo/web-serial-rxjs/workspace",
  "version": "4.1.3",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "test": "nx run-many --target=test --all",
    "docs:guide": "node packages/web-serial-rxjs/scripts/relocate-typedoc-guide.mjs",
    "docs:index": "node packages/web-serial-rxjs/scripts/build-docs-index.mjs",
    "docs:examples-index": "node packages/web-serial-rxjs/scripts/build-examples-index.mjs",
    "docs:example-angular": "node packages/web-serial-rxjs/scripts/package-example-angular-portal.mjs",
    "docs:example-react": "node packages/web-serial-rxjs/scripts/package-example-react-portal.mjs",
    "docs:example-svelte": "node packages/web-serial-rxjs/scripts/package-example-svelte-portal.mjs",
    "docs:example-vanilla-js": "node packages/web-serial-rxjs/scripts/package-example-vanilla-js-portal.mjs",
    "docs:example-vanilla-ts": "node packages/web-serial-rxjs/scripts/package-example-vanilla-ts-portal.mjs",
    "docs:example-vue": "node packages/web-serial-rxjs/scripts/package-example-vue-portal.mjs",
    "docs:check-links": "node packages/web-serial-rxjs/scripts/check-docs-links.mjs",
    "docs:generate": "typedoc --options packages/web-serial-rxjs/typedoc.json && node packages/web-serial-rxjs/scripts/fix-typedoc-links.mjs",
    "docs:patch-assets": "node packages/web-serial-rxjs/scripts/patch-docs-assets.mjs",
    "docs:gitignore": "node -e \"require('fs').writeFileSync('docs/.gitignore','# Generated documentation output — do not commit.\\n# Source lives under packages/web-serial-rxjs/docs/guide/\\n# See packages/web-serial-rxjs/docs/ARCHITECTURE.md\\n*\\n!.gitignore\\n')\"",
    "docs:nojekyll": "node -e \"require('fs').mkdirSync('docs',{recursive:true});require('fs').writeFileSync('docs/.nojekyll','')\"",
    "docs:clean": "node -e \"const fs=require('fs'),p=require('path'),d='docs';fs.mkdirSync(d,{recursive:true});for(const e of fs.readdirSync(d))e!=='.gitignore'&&fs.rmSync(p.join(d,e),{recursive:true,force:true});\"",
    "docs:portal": "node packages/web-serial-rxjs/scripts/package-docs-portal.mjs",
    "docs": "pnpm run docs:clean && pnpm run docs:generate && pnpm run docs:guide && pnpm run docs:patch-assets && pnpm run docs:index && pnpm run docs:examples-index && pnpm run docs:example-angular && pnpm run docs:example-react && pnpm run docs:example-svelte && pnpm run docs:example-vanilla-js && pnpm run docs:example-vanilla-ts && pnpm run docs:example-vue && pnpm run docs:check-links && pnpm run docs:nojekyll && pnpm run docs:gitignore && pnpm run docs:portal",
    "publish:test": "pnpm publish --dry-run --no-git-checks --filter @gurezo/web-serial-rxjs",
    "publish": "pnpm publish --filter @gurezo/web-serial-rxjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gurezo/web-serial-rxjs.git"
  },
